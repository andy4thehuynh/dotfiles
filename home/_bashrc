# ~/.bashrc — cross-platform shell config (macOS + Linux/Omakub)

OS="$(uname -s)"

# Sourced secrets (API keys, etc.)
[ -r ~/.env_secrets ] && . ~/.env_secrets

# On Linux/Omakub: source Omakub's baseline first, then layer personal config on top.
# Omakub's rc handles: PATH, aliases, functions, prompt, tool inits (fzf, mise, zoxide).
if [[ "$OS" == "Linux" ]] && [ -r "$HOME/.local/share/omakub/defaults/bash/rc" ]; then
  . "$HOME/.local/share/omakub/defaults/bash/rc"
fi

##########################################################
# Environment
##########################################################

export EDITOR='nvim'
export GOPATH="$HOME/go"

if [[ "$OS" == "Darwin" ]]; then
  export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:$GOPATH/bin:$PATH"
  export PATH="/Applications/Couchbase Server.app/Contents/Resources/couchbase-core/bin:$PATH"
  export PATH="$PATH:$HOME/.lmstudio/bin"
else
  export PATH="$HOME/bin:$HOME/.local/bin:$GOPATH/bin:$PATH"
fi

export TMUXINATOR_CONFIG="$HOME/.config/tmuxinator"
export NVIM_AI_ASSISTANT="agy"

# --- Bat (better cat) ---
export BAT_THEME="Catppuccin%20Frappe"
export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat -p -lman'"

# --- fzf + fd ---
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

_fzf_compgen_path() {
  fd --hidden --exclude .git . "$1"
}
_fzf_compgen_dir() {
  fd --type=d --hidden --exclude .git . "$1"
}

##########################################################
# History
##########################################################

shopt -s histappend
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

##########################################################
# Interactive-only: vi mode, readline bindings, completion
##########################################################

if [[ $- == *i* ]]; then
  set -o vi
  bind '"jj":vi-movement-mode'

  bind 'set show-mode-in-prompt on'
  bind 'set vi-ins-mode-string "\1\e[6 q\2"'
  bind 'set vi-cmd-mode-string "\1\e[2 q\2"'

  bind 'set completion-ignore-case on'
  bind 'set completion-map-case on'

  # bash-completion (platform-specific paths)
  if [[ "$OS" == "Darwin" ]]; then
    if [ -r /opt/homebrew/etc/profile.d/bash_completion.sh ]; then
      . /opt/homebrew/etc/profile.d/bash_completion.sh
    fi
  else
    if [ -r /usr/share/bash-completion/bash_completion ]; then
      . /usr/share/bash-completion/bash_completion
    fi
  fi
fi

##########################################################
# Aliases
# These override Omakub's defaults on Linux where they differ.
##########################################################

# git
alias g='git'
alias ga='git add'
alias gaa='git add -A'
alias gc='git commit --verbose'
alias gca='git commit --amend'
alias gs='git status'
alias gss='git status -s'
alias gco='git checkout'
alias gcob='git checkout -b'
alias gd='git diff'
alias gdc='git diff --cached'
alias grh='git reset HEAD'
alias gdh='git diff origin/master..HEAD'

# tmux / tmuxinator
alias t='tmuxinator'
alias tm='tmux'
alias tks='tmux kill-session'

# zellij
alias zj='zellij'
alias zja='zellij attach'
alias zjl='zellij list-sessions'
alias zjk='zellij delete-session --force'
zjs() { zellij -n "$1" -s "$1"; }

# editor
alias n='nvim'
alias nb='NVIM_APPNAME="nvim.bak" nvim'

# couchbase
alias lazycb='lazycouchbase'

# shell reload / dotfiles
alias rlb="source ${HOME}/.bashrc"
alias cdd="cd ${HOME}/Code/dotfiles"

# misc
alias fabric='fabric-ai'
alias be='bundle exec'
alias cbsh="cbsh --config-dir ${XDG_CONFIG_HOME:-$HOME/.config}/cbsh"

# tool replacements
alias ls='eza --icons=always'
alias lsa='eza --icons=always --all --long --header'
alias cat='bat --paging=never'
alias less='bat --paging=always'
alias ts='tailscale'

complete -o default -o bashdefault ls lsa

##########################################################
# Tool init (macOS only — Omakub handles these on Linux)
##########################################################

if [[ "$OS" == "Darwin" ]]; then
  unset GEM_HOME GEM_PATH
  export GOBIN=$GOPATH/bin
fi

# Tool init — both hosts. macOS uses ~/.local/bin/mise; Linux uses /usr/bin/mise (Omarchy).
if [[ "$OS" == "Darwin" ]]; then
  eval "$(fzf --bash)"
  eval "$(~/.local/bin/mise activate bash)"
else
  eval "$(fzf --bash)" 2>/dev/null || source /usr/share/fzf/key-bindings.bash 2>/dev/null
  eval "$(mise activate bash)"
fi

eval "$(starship init bash)"
eval "$(zoxide init bash)"
alias cd='z'

##########################################################
# Tmux dev layouts (ported from Omarchy's default/bash/fns/tmux)
##########################################################

# Editor left, AI agent(s) right, terminal along the bottom
# Usage: tdl <claude|codex|other_ai> [<second_ai>]
tdl() {
  [[ -z $1 ]] && { echo "Usage: tdl <agent> [<second_agent>]"; return 1; }
  [[ -z $TMUX ]] && { echo "You must start tmux to use tdl."; return 1; }

  local current_dir="${PWD}"
  local editor_pane ai_pane ai2_pane
  local ai="$1"
  local ai2="$2"

  # TMUX_PANE stays valid even if the active window changes mid-setup
  editor_pane="$TMUX_PANE"

  tmux rename-window -t "$editor_pane" "$(basename "$current_dir")"

  # Terminal across the bottom 15%
  tmux split-window -v -l 15% -t "$editor_pane" -c "$current_dir"

  # Agent down the right 30%
  ai_pane=$(tmux split-window -h -l 30% -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')

  if [[ -n $ai2 ]]; then
    ai2_pane=$(tmux split-window -v -t "$ai_pane" -c "$current_dir" -P -F '#{pane_id}')
    tmux send-keys -t "$ai2_pane" "$ai2" C-m
  fi

  tmux send-keys -t "$ai_pane" "$ai" C-m
  tmux send-keys -t "$editor_pane" "$EDITOR ." C-m

  tmux select-pane -t "$editor_pane"
}

# Four-way square: editor, live diff, terminal, agent
# Usage: tds [<agent>]
tds() {
  [[ -z $TMUX ]] && { echo "You must start tmux to use tds."; return 1; }

  local current_dir="${PWD}"
  local editor_pane diff_pane terminal_pane ai_pane
  local ai="${1:-claude}"

  editor_pane="$TMUX_PANE"

  tmux rename-window -t "$editor_pane" "$(basename "$current_dir")"

  terminal_pane=$(tmux split-window -v -l 50% -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')
  diff_pane=$(tmux split-window -h -l 50% -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')
  ai_pane=$(tmux split-window -h -l 50% -t "$terminal_pane" -c "$current_dir" -P -F '#{pane_id}')

  tmux send-keys -t "$editor_pane" "$EDITOR ." C-m
  tmux send-keys -t "$diff_pane" "git diff" C-m
  tmux send-keys -t "$ai_pane" "$ai" C-m

  tmux select-pane -t "$editor_pane"
}

# One tdl window per subdirectory, reachable with alt+1..9
# Usage: tdlm <agent> [<second_agent>]
tdlm() {
  [[ -z $1 ]] && { echo "Usage: tdlm <agent> [<second_agent>]"; return 1; }
  [[ -z $TMUX ]] && { echo "You must start tmux to use tdlm."; return 1; }

  local ai="$1"
  local ai2="$2"
  local base_dir="$PWD"
  local first=true
  local dir dirpath pane_id

  # tmux disallows dots and colons in session names
  tmux rename-session "$(basename "$base_dir" | tr '.:' '--')"

  for dir in "$base_dir"/*/; do
    [[ -d $dir ]] || continue
    dirpath="${dir%/}"

    if $first; then
      tmux send-keys -t "$TMUX_PANE" "cd '$dirpath' && tdl $ai $ai2" C-m
      first=false
    else
      pane_id=$(tmux new-window -c "$dirpath" -P -F '#{pane_id}')
      tmux send-keys -t "$pane_id" "tdl $ai $ai2" C-m
    fi
  done
}

# Tiled grid running the same command in every pane, for a swarm of agents
# Usage: tsl <pane_count> <command>
tsl() {
  [[ -z $1 || -z $2 ]] && { echo "Usage: tsl <pane_count> <command>"; return 1; }
  [[ -z $TMUX ]] && { echo "You must start tmux to use tsl."; return 1; }

  local count="$1"
  local cmd="$2"
  local current_dir="${PWD}"
  local -a panes
  local new_pane pane

  tmux rename-window -t "$TMUX_PANE" "$(basename "$current_dir")"
  panes+=("$TMUX_PANE")

  while ((${#panes[@]} < count)); do
    new_pane=$(tmux split-window -h -t "${panes[-1]}" -c "$current_dir" -P -F '#{pane_id}')
    panes+=("$new_pane")
    tmux select-layout -t "${panes[0]}" tiled
  done

  for pane in "${panes[@]}"; do
    tmux send-keys -t "$pane" "$cmd" C-m
  done

  tmux select-pane -t "${panes[0]}"
}
