# Omarchy Quattro (v4) terminal feel, translated from foot.ini

font-family = JetBrainsMono Nerd Font Mono
font-size = 16

theme = Catppuccin Mocha

window-padding-x = 14
window-padding-y = 14

cursor-style = block
cursor-style-blink = false

scrollback-limit = 10000000

# Hide macOS traffic lights + title bar
macos-titlebar-style = hidden
